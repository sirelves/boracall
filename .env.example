# Copy to .env and adjust for your environment.

# --- server ---
BC_BIND=127.0.0.1:3030
DATABASE_URL=postgres://boracall:boracall@127.0.0.1:5432/boracall
BC_JWT_SECRET=change-me-to-a-long-random-string-at-least-24-chars
BC_JWT_TTL_DAYS=30
BC_CORS_ANY=1
RUST_LOG=boracall_server=info,tower_http=info,sqlx=warn

# --- OTP ---
# Códigos de verificação e de reset ficam no Postgres (tabela otp_codes), não em
# memória: assim um restart não invalida o código que a pessoa acabou de receber,
# e dois nós validam o que o outro emitiu. Guardados como hash, com contador de
# tentativas — 5 erros queimam o código.

# --- Limite de requisições ---
# Por IP nas rotas de auth: contém força bruta de senha e criação em massa.
BC_RL_AUTH_BURST=10
BC_RL_AUTH_JANELA_SECS=60
# Por e-mail de DESTINO nas rotas que disparam mensagem. É o que impede alguém
# de trocar de IP pra encher a caixa de uma vítima e queimar a cota do Resend.
BC_RL_EMAIL_BURST=3
BC_RL_EMAIL_JANELA_SECS=3600

# --- WebRTC (STUN/TURN) ---
# Sem BC_TURN_SECRET + BC_TURN_URLS, o GET /api/ice devolve só STUN — e quem
# está atrás de NAT simétrica não consegue conectar. O segredo tem que ser o
# mesmo `static-auth-secret` do /etc/turnserver.conf do coturn.
BC_STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
# BC_TURN_URLS=turn:SEU.IP.AQUI:3478?transport=udp,turn:SEU.IP.AQUI:3478?transport=tcp
# BC_TURN_SECRET=o-mesmo-static-auth-secret-do-coturn
BC_TURN_TTL_SECS=3600

# --- desktop ---
# Where the desktop looks for the backend. Baked in at build time via dist/env.js
# when present; otherwise defaults to http://127.0.0.1:3030 in dev.
BC_API_URL=http://127.0.0.1:3030
