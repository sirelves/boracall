{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BoraCall",
  "version": "0.3.0",
  "identifier": "app.boracall.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "BoraCall",
        "width": 880,
        "height": 680,
        "minWidth": 640,
        "minHeight": 520,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://boracall.com/downloads/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIwNjk0MkMyRkVEQUVBM0QKUldROTZ0cit3a0pwc0JLSlliUWFyMHI4Rkp2cC9MaHBpL2hjWWpMQS8wNWxURlNIcWx6TmF5WGwK"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "SocialNetworking",
    "shortDescription": "Chamada de voz sem enrolação",
    "longDescription": "BoraCall é um app de chamada de voz em grupo, leve e sem distração. Cria uma sala, compartilha o link, pronto.",
    "copyright": "© 2026 BoraCall",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "frameworks": [],
      "providerShortName": null,
      "entitlements": null
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "nsis": {
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "installMode": "perMachine"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    }
  }
}
