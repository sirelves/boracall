{
  "db_name": "PostgreSQL",
  "query": "\n        WITH inserted AS (\n            INSERT INTO messages (channel_id, user_id, body)\n            VALUES ($1, $2, $3)\n            RETURNING id, channel_id, user_id, body, created_at, edited_at\n        )\n        SELECT i.id, i.channel_id, i.user_id, i.body, i.created_at, i.edited_at,\n               u.display_name\n        FROM inserted i\n        JOIN users u ON u.id = i.user_id\n        ",
