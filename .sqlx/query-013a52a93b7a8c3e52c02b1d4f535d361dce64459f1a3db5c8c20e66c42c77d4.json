{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT m.id, m.channel_id, m.user_id, m.body, m.created_at, m.edited_at,\n                   u.display_name\n            FROM messages m\n            JOIN users u ON u.id = m.user_id\n            WHERE m.channel_id = $1\n            ORDER BY m.created_at DESC, m.id DESC\n            LIMIT $2\n            ",
