{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT c.id, c.kind, s.slug AS server_slug, (m.user_id IS NOT NULL) AS \"is_member!\"\n        FROM channels c\n        JOIN servers s ON s.id = c.server_id\n        LEFT JOIN server_members m ON m.server_id = s.id AND m.user_id = $2\n        WHERE c.slug = $1\n        ",
