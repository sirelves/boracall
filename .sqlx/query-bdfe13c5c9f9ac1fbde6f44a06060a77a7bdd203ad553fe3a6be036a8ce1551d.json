{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT m.user_id, m.channel_id, s.owner_id, s.slug AS server_slug\n        FROM messages m\n        JOIN channels c ON c.id = m.channel_id\n        JOIN servers s ON s.id = c.server_id\n        WHERE m.id = $1\n        ",
