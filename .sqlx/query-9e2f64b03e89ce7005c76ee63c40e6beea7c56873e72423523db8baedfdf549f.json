  "query": "\n        SELECT c.id, c.slug, c.name, c.kind, c.position,\n               s.id AS server_id, s.slug AS server_slug, s.name AS server_name\n        FROM channels c\n        JOIN servers s ON s.id = c.server_id\n        WHERE c.slug = $1\n        ",
