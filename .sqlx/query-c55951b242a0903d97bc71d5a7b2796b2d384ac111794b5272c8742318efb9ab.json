{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT s.id, s.slug, s.name, s.owner_id, s.created_at,\n               m.role,\n               (SELECT COUNT(*) FROM server_members WHERE server_id = s.id) AS \"member_count!\"\n        FROM servers s\n        JOIN server_members m ON m.server_id = s.id\n        WHERE m.user_id = $1\n        ORDER BY s.created_at DESC\n        ",
